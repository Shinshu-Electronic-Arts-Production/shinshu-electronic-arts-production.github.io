---
import { Image } from 'astro:assets';
import { gameUrl, type Game } from '../lib/games';

interface Props {
  game: Game;
}
const { game } = Astro.props;
const { title, summary, cover, tags, draft } = game.data;
---

<li class="card" data-tags={JSON.stringify(tags)}>
  <a href={gameUrl(game.id)}>
    <Image src={cover} alt="" widths={[400, 800]} sizes="(max-width: 640px) 100vw, 400px" class="card-cover" />
    <div class="card-body">
      <h3>{title}{draft && <span class="badge">draft</span>}</h3>
      <p>{summary}</p>
      {
        tags.length > 0 && (
          <ul class="tags tags-small">
            {tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        )
      }
    </div>
  </a>
</li>
